ANTHROPIC_API_KEY=
MODEL_ANALYSIS=claude-opus-5-5
MODEL_GENERATION=claude-opus-5-5
DATA_DIR=./data

# Ingestion (valeurs par défaut)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SCENE_THRESHOLD=0.3
VISION_BATCH_SIZE=10
MAX_VIDEO_DURATION_S=600
INGEST_WORKER_ENABLED=true

# Patterns (valeurs par défaut)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
PATTERN_MERGE_THRESHOLD=0.85
